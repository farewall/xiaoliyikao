.result {
  font-size: 36rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.correct-answer {
  font-size: 28rpx;
  margin-bottom: 8rpx;
  font-weight: 500;
}

/* 选项回顾(记录详情:绿=正确答案,红=你选错的项) */
.option-line {
  display: flex;
  align-items: flex-start;
  font-size: 28rpx;
  line-height: 1.5;
  padding: 16rpx 20rpx;
  margin-bottom: 12rpx;
  border: 2rpx solid #e2e8f0;
  border-radius: 20rpx;
}

.option-key {
  width: 40rpx;
  flex-shrink: 0;
  font-weight: 600;
}

.option-text {
  flex: 1;
}

.mark {
  margin-left: 12rpx;
  flex-shrink: 0;
  font-weight: 700;
}

.opt-correct {
  border-color: #38a169;
  background: #f0fdf4;
  color: #2f855a;
}

.opt-user {
  border-color: #e53e3e;
  background: #fff5f5;
  color: #c53030;
}

.explanation {
  line-height: 1.7;
  color: #4a5568;
}
