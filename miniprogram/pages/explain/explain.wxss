.result {
  font-size: 36rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.correct-answer {
  font-size: 28rpx;
  margin-bottom: 8rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.stem {
  font-size: 30rpx;
  line-height: 1.6;
  margin-bottom: 16rpx;
}

.option-line {
  font-size: 28rpx;
  line-height: 1.5;
  margin-bottom: 8rpx;
}

.explanation {
  line-height: 1.7;
}

.ask-input {
  width: 100%;
  height: 140rpx;
  border: 2rpx solid #e2e8f0;
  border-radius: 12rpx;
  padding: 16rpx;
  box-sizing: border-box;
  font-size: 28rpx;
  margin-bottom: 16rpx;
}

.ask-actions {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.ask-actions .btn-primary {
  flex: 1;
}

.quota-remaining {
  flex-shrink: 0;
}

.ai-answer {
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 2rpx solid #f0f0f0;
}

.ai-answer-text {
  line-height: 1.7;
  font-size: 28rpx;
}

.ai-references {
  margin-top: 12rpx;
  font-size: 22rpx;
}
