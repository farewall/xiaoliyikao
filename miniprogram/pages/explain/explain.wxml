<view class="container">
  <!-- 判分结果 -->
  <view class="card">
    <view class="result {{isCorrect ? 'text-success' : 'text-danger'}}">
      {{isCorrect ? '✓ 回答正确' : '✗ 回答错误'}}
    </view>
    <view wx:if="{{!isCorrect}}" class="correct-answer">
      正确答案:{{result.correct_answer.join('、')}}
    </view>
    <view class="text-secondary">你的答案:{{result.user_answer_text || '—'}}</view>
  </view>

  <!-- 题干回顾 -->
  <view class="card" wx:if="{{question}}">
    <view class="stem">{{question.stem}}</view>
    <view class="options" wx:for="{{optionKeys}}" wx:key="*this">
      <view class="option-line">{{item}}. {{question.options[item]}}</view>
    </view>
  </view>

  <!-- 解析 -->
  <view class="card" wx:if="{{result.explanation}}">
    <view class="section-title">解析</view>
    <view class="explanation">{{result.explanation}}</view>
  </view>

  <!-- AI 追问答疑 -->
  <view class="card">
    <view class="section-title">没看懂?问 AI 教练 🐟</view>
    <textarea
      class="ask-input"
      placeholder="针对这道题,哪里不明白?比如:为什么选 C 不选 B?"
      value="{{userQuestion}}"
      bindinput="onQuestionInput"
      maxlength="300"
    />
    <view class="ask-actions">
      <view class="btn-primary {{asking ? 'disabled' : ''}}" bindtap="onAsk">
        {{asking ? 'AI 思考中…' : '追问'}}
      </view>
      <view class="quota-remaining text-secondary" wx:if="{{quotaRemaining !== null}}">
        今日剩余 {{quotaRemaining}} 次
      </view>
    </view>

    <!-- AI 回答 -->
    <view class="ai-answer" wx:if="{{aiAnswer}}">
      <view class="ai-answer-text">{{aiAnswer}}</view>
      <view class="ai-references text-secondary" wx:if="{{aiReferences.length}}">
        参考:{{aiReferences.join(' · ')}}
      </view>
    </view>
  </view>

  <!-- 下一题 -->
  <view class="btn-primary" bindtap="onNext">下一题</view>
</view>
