<view class="container">
  <!-- 判分结果 -->
  <view class="card">
    <view class="result {{isCorrect ? 'text-success' : 'text-danger'}}">
      {{isCorrect ? '✓ 回答正确' : '✗ 这题值得回看'}}
    </view>
    <view wx:if="{{!isCorrect}}" class="correct-answer">
      正确答案:{{answerText}}
    </view>
    <view class="text-secondary">你的答案:{{userAnswerText || '—'}}</view>
  </view>

  <!-- 题目回顾 -->
  <view class="card" wx:if="{{question}}">
    <view class="stem">{{question.stem}}</view>
    <view
      class="option-line opt-{{item.state}}"
      wx:for="{{optionStates}}"
      wx:key="key"
    >
      <text class="option-key">{{item.key}}</text>
      <text class="option-text">{{item.text}}</text>
      <text wx:if="{{item.state === 'correct'}}" class="mark">✓</text>
      <text wx:elif="{{item.state === 'user'}}" class="mark">✗</text>
    </view>
  </view>

  <!-- 解析 -->
  <view class="card" wx:if="{{question && question.explanation}}">
    <view class="section-title">解析</view>
    <view class="explanation">{{question.explanation}}</view>
  </view>

  <!-- AI 追问答疑 -->
  <view class="card">
    <view class="section-title">没看懂?问 AI 教练 🐟</view>
    <textarea
      class="ask-input"
      placeholder="针对这道题,哪里不明白?比如:为什么选 C 不选 B?"
      value="{{userQuestion}}"
      bindinput="onQuestionInput"
      maxlength="300"
    />
    <view class="ask-actions">
      <view class="btn-primary {{asking ? 'disabled' : ''}}" bindtap="onAsk">
        {{asking ? 'AI 思考中…' : '追问'}}
      </view>
      <view class="quota-remaining text-secondary" wx:if="{{quotaRemaining !== null}}">
        今日剩余 {{quotaRemaining}} 次
      </view>
    </view>

    <view class="ai-answer" wx:if="{{aiAnswer}}">
      <view class="ai-answer-text">{{aiAnswer}}</view>
      <view class="ai-references text-secondary" wx:if="{{aiReferencesText}}">
        参考:{{aiReferencesText}}
      </view>
    </view>
  </view>
</view>
