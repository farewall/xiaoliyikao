.center {
  text-align: center;
  padding: 40rpx 24rpx;
}

.report-title {
  font-size: 34rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
}

.score-line {
  font-size: 30rpx;
  color: #666;
  margin-bottom: 8rpx;
}

.est-score {
  font-size: 72rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
  background: linear-gradient(135deg, #5BA9FF 0%, #2B6CB0 100%);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}

.est-unit {
  font-size: 32rpx;
  font-weight: 400;
  color: #888;
}

.tip-card {
  font-size: 28rpx;
  line-height: 1.6;
  color: #555;
}

.tip-btn {
  margin-top: 20rpx;
}

/* 各科正确率 */
.subject-row {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.subject-name {
  width: 120rpx;
  flex-shrink: 0;
  font-size: 28rpx;
}

.subject-bar {
  flex: 1;
  height: 16rpx;
  background: #edf2f7;
  border-radius: 8rpx;
  overflow: hidden;
  margin: 0 16rpx;
}

.subject-fill {
  height: 100%;
  border-radius: 8rpx;
  background: linear-gradient(90deg, #5BA9FF 0%, #2B6CB0 100%);
}

.subject-pct {
  width: 80rpx;
  text-align: right;
  font-size: 26rpx;
  color: #888;
}

/* 重点回顾 */
.wrong-item {
  padding: 20rpx 0;
  border-bottom: 2rpx solid #f5f5f5;
}

.wrong-item:last-child {
  border-bottom: none;
}

.wrong-item:active {
  background: #fafcff;
}

.wrong-stem {
  font-size: 28rpx;
  line-height: 1.5;
  margin-bottom: 8rpx;
}
