.center {
  text-align: center;
  padding: 80rpx 24rpx;
}

/* 切换 tabs(渐变激活) */
.tabs {
  display: flex;
  background: #fff;
  border-radius: 20rpx;
  padding: 8rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 6rpx 24rpx rgba(43, 108, 176, 0.06);
}

.tab {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  font-size: 28rpx;
  color: #888;
  border-radius: 16rpx;
  transition: all 0.15s ease;
}

.tab-active {
  background: linear-gradient(135deg, #5BA9FF 0%, #2B6CB0 100%);
  color: #fff;
  font-weight: 600;
  box-shadow: 0 6rpx 16rpx rgba(43, 108, 176, 0.25);
}

/* 时间分组 */
.day-group {
  margin-bottom: 8rpx;
}

.day-label {
  font-size: 26rpx;
  color: #888;
  font-weight: 500;
  margin: 8rpx 8rpx 16rpx;
}

/* 记录行 */
.rec-row {
  display: flex;
  align-items: center;
}

.rec-row:active {
  background: #fafcff;
}

.rec-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.rec-icon.practice {
  background: linear-gradient(135deg, #7CC4FF 0%, #2B6CB0 100%);
}

.rec-icon.mock {
  background: linear-gradient(135deg, #52E0C4 0%, #22A79E 100%);
}

.rec-main {
  flex: 1;
  margin-right: 16rpx;
}

.rec-title {
  font-size: 30rpx;
  font-weight: 500;
  margin-bottom: 6rpx;
}

.rec-right {
  text-align: right;
  flex-shrink: 0;
}

.rec-acc {
  font-size: 28rpx;
  font-weight: 700;
  margin-bottom: 6rpx;
  background: linear-gradient(135deg, #5BA9FF 0%, #2B6CB0 100%);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}

/* 展开的错题 */
.wrong-block {
  margin-top: 16rpx;
  padding-top: 8rpx;
  border-top: 2rpx solid #f5f5f5;
}

.wrong-item {
  padding: 16rpx 0;
  border-bottom: 2rpx solid #f5f5f5;
}

.wrong-item:last-child {
  border-bottom: none;
}

.wrong-stem {
  font-size: 28rpx;
  line-height: 1.5;
  margin-bottom: 6rpx;
}

.wrong-empty {
  margin-top: 16rpx;
}
