<view class="container">
  <!-- 加载中 -->
  <view wx:if="{{loading}}" class="card center">
    <view class="text-secondary">题目加载中…</view>
  </view>

  <!-- 空题库 -->
  <view wx:elif="{{!questions.length}}" class="card center">
    <view class="text-secondary">题库还空着,先去后端录入题目吧</view>
  </view>

  <!-- 做题 -->
  <block wx:else>
    <view class="progress">第 {{current + 1}} / {{questions.length}} 题</view>

    <view class="card">
      <!-- 题干 -->
      <view class="stem">{{currentQuestion.stem}}</view>

      <!-- 选项 -->
      <view
        class="option {{selected.indexOf(key) > -1 ? 'selected' : ''}}"
        wx:for="{{optionKeys}}"
        wx:key="*this"
        data-key="{{item}}"
        bindtap="onToggleOption"
      >
        <view class="option-key">{{item}}</view>
        <view class="option-text">{{currentQuestion.options[item]}}</view>
      </view>
    </view>

    <!-- 操作区 -->
    <view class="action-row">
      <view class="btn-primary {{selected.length ? '' : 'disabled'}}" bindtap="onSubmit">
        提交答案
      </view>
    </view>
  </block>
</view>
