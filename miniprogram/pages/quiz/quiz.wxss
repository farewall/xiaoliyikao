.center {
  text-align: center;
  padding: 80rpx 24rpx;
}

.progress {
  text-align: center;
  color: #888;
  margin-bottom: 16rpx;
  font-size: 26rpx;
}

/* 原地反馈 */
.result {
  font-size: 36rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.correct-answer {
  font-size: 28rpx;
  margin-bottom: 8rpx;
  font-weight: 500;
}

.explanation {
  line-height: 1.7;
  color: #4a5568;
}

/* 小结 */
.summary-title {
  font-size: 40rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.summary-score {
  font-size: 48rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
  background: linear-gradient(135deg, #5BA9FF 0%, #2B6CB0 100%);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}

/* 重点回顾列表 */
.weak-item {
  padding: 20rpx 0;
  border-bottom: 2rpx solid #f5f5f5;
}

.weak-item:last-child {
  border-bottom: none;
}

.weak-item:active {
  background: #fafcff;
}

.weak-main {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.weak-name {
  font-size: 28rpx;
  line-height: 1.5;
  flex: 1;
  margin-right: 16rpx;
}
