.center {
  text-align: center;
  padding: 80rpx 24rpx;
}

.progress {
  text-align: center;
  color: #888;
  margin-bottom: 16rpx;
  font-size: 26rpx;
}

.stem {
  font-size: 32rpx;
  line-height: 1.6;
  margin-bottom: 24rpx;
}

.option {
  display: flex;
  align-items: flex-start;
  padding: 20rpx;
  border: 2rpx solid #e2e8f0;
  border-radius: 12rpx;
  margin-bottom: 16rpx;
}

.option.selected {
  border-color: #2B6CB0;
  background: #f0f7ff;
}

.option-key {
  width: 48rpx;
  height: 48rpx;
  line-height: 48rpx;
  text-align: center;
  border-radius: 50%;
  background: #edf2f7;
  font-weight: 600;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.option.selected .option-key {
  background: #2B6CB0;
  color: #fff;
}

.option-text {
  flex: 1;
  line-height: 1.5;
}

.action-row {
  margin-top: 32rpx;
}
