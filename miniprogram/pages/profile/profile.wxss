.user-card {
  display: flex;
  align-items: center;
}

.avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #e6f0fa;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  margin-right: 24rpx;
}

.nickname {
  font-size: 34rpx;
  font-weight: 600;
  margin-bottom: 4rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
}

.empty {
  text-align: center;
  padding: 32rpx 0;
}

.weak-item {
  padding: 20rpx 0;
  border-bottom: 2rpx solid #f5f5f5;
}

.weak-item:last-child {
  border-bottom: none;
}

.weak-main {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.weak-name {
  font-size: 30rpx;
  font-weight: 500;
}

.weak-accuracy {
  font-weight: 600;
}

.weak-sub {
  margin-top: 8rpx;
}

.quota-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
