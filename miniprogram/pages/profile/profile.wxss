.user-card {
  display: flex;
  align-items: center;
}

.avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #7CC4FF 0%, #2B6CB0 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  margin-right: 24rpx;
  box-shadow: 0 8rpx 18rpx rgba(43, 108, 176, 0.2);
  flex-shrink: 0;
}

.nickname {
  font-size: 34rpx;
  font-weight: 600;
  margin-bottom: 4rpx;
}

.empty {
  text-align: center;
  padding: 32rpx 0;
}

/* 学习统计:渐变大数字 */
.stats-card {
  display: flex;
  align-items: center;
  justify-content: space-around;
  padding: 32rpx 24rpx;
}

.stat-item {
  text-align: center;
  flex: 1;
}

.stat-num {
  font-size: 48rpx;
  font-weight: 700;
  background: linear-gradient(135deg, #5BA9FF 0%, #2B6CB0 100%);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}

.stat-label {
  font-size: 24rpx;
  color: #888;
  margin-top: 4rpx;
}

.stat-sep {
  width: 2rpx;
  height: 56rpx;
  background: #f0f0f0;
}

/* 提分点卡片 */
.weak-card {
  padding: 20rpx;
  border: 2rpx solid #e2e8f0;
  border-radius: 20rpx;
  margin-bottom: 16rpx;
}

.weak-card:last-child {
  margin-bottom: 0;
}

.weak-card:active {
  background: #fafcff;
}

.weak-top {
  display: flex;
  align-items: center;
  margin-bottom: 10rpx;
}

.weak-tag {
  flex-shrink: 0;
  margin-right: 14rpx;
  padding: 4rpx 16rpx;
  border-radius: 24rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: #fff;
  background: linear-gradient(135deg, #FFC878 0%, #FF8A3D 100%);
  box-shadow: 0 4rpx 10rpx rgba(255, 138, 61, 0.25);
}

.weak-name {
  font-size: 28rpx;
  font-weight: 600;
  flex: 1;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.weak-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.weak-space {
  font-size: 26rpx;
  font-weight: 600;
  color: #ff8a3d;
}

/* 历史记录入口 */
.entry {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.entry:active {
  background: #fafcff;
}

.entry-title {
  font-size: 30rpx;
  font-weight: 500;
  margin-bottom: 4rpx;
}

.entry-arrow {
  font-size: 40rpx;
  color: #cbd5e1;
}

/* 设置区 */
.settings .section-title {
  margin-bottom: 8rpx;
}

.quota-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 2rpx solid #f5f5f5;
}

.set-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
}

.set-row:active {
  background: #fafcff;
}
