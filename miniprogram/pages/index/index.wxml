<view class="container">
  <!-- 渐变头部 Hero -->
  <view class="hero">
    <view class="hero-top">
      <view class="hero-greet">
        <view class="hero-greet-title">{{greeting}},{{nickname || '同学'}}</view>
        <view class="hero-greet-sub">每天进步一点点,坚持就是胜利</view>
      </view>
      <view class="hero-avatar">🐟</view>
    </view>

    <view class="hero-stats">
      <view class="hero-stat">
        <view class="hero-num">{{todayCount}}</view>
        <view class="hero-label">今日已刷</view>
      </view>
      <view class="hero-stat">
        <view class="hero-num">{{totalCount}}</view>
        <view class="hero-label">累计已刷</view>
      </view>
      <view class="hero-stat">
        <view class="hero-num">{{aiQuota === null ? '—' : aiQuota}}</view>
        <view class="hero-label">AI 追问</view>
      </view>
    </view>
  </view>

  <!-- 刷题入口 -->
  <view class="entry-list">
    <view class="card entry-card" bindtap="onPractice">
      <view class="entry-icon practice">📖</view>
      <view class="entry-main">
        <view class="entry-title">练习</view>
        <view class="entry-desc">单科聚焦 · 答一题讲一题 · 巩固考点</view>
      </view>
      <view class="entry-arrow">›</view>
    </view>

    <view class="card entry-card" bindtap="onMock">
      <view class="entry-icon mock">⏱️</view>
      <view class="entry-main">
        <view class="entry-title">模拟测试</view>
        <view class="entry-desc">仿真限时 · 检验真实水平 · 出估分报告</view>
      </view>
      <view class="entry-arrow">›</view>
    </view>
  </view>
</view>
