/**app.wxss - 全局样式*/
page {
  background: #f5f6f8;
  font-size: 28rpx;
  color: #2d2d2d;
}

.container {
  padding: 24rpx;
}

/* 卡片 */
.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

/* 按钮 */
.btn-primary {
  background: #2B6CB0;
  color: #fff;
  border-radius: 12rpx;
  font-size: 30rpx;
  padding: 20rpx 0;
  text-align: center;
}

.btn-primary:active {
  opacity: 0.85;
}

.btn-primary[disabled] {
  background: #a8c6e2;
}

/* 文本工具 */
.text-secondary {
  color: #888;
  font-size: 26rpx;
}

.text-danger {
  color: #e53e3e;
}

.text-success {
  color: #38a169;
}

.text-bold {
  font-weight: 600;
}
