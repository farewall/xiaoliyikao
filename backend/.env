# 复制为 .env 并填入真实值(docker compose 会自动读取)

# 应用
APP_ENV=development
DEBUG=true

# 数据库(本地开发时无需改,docker compose 会用内部的 db 服务)
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/xiaoliyikao

# DeepSeek(必填,RAG 答疑依赖)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# 免费层每日 AI 追问次数
FREE_AI_QUOTA_PER_DAY=5

# 微信(登录 code2session 用,开发期可留空)
WECHAT_APPID=
WECHAT_SECRET=
