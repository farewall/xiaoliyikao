# 复制为 .env 并填入真实值

# 应用
APP_ENV=development
DEBUG=true

# 数据库(改成你自己的库/密码;测试用 xiaoliyikao_dev,生产用 xiaoliyikao_prod)
DATABASE_URL=postgresql+psycopg2://xiaoliyikao:改成你的密码@localhost:5432/xiaoliyikao_dev

# DeepSeek(必填,RAG 答疑依赖)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# 免费层每日 AI 追问次数
FREE_AI_QUOTA_PER_DAY=5

# 微信(登录 code2session 用;配了才走真实 openid,否则开发占位)
WECHAT_APPID=
WECHAT_SECRET=

# 登录态(JWT 签名密钥,生产务必换成强随机串)
JWT_SECRET=dev-secret-change-me-in-production
JWT_EXPIRE_DAYS=7
